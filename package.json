{
  "name": "dairy-farm-app-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm --prefix apps/api run start:dev",
    "build:api": "npm --prefix apps/api run build",
    "test:api": "npm --prefix apps/api run test",
    "test:mobile": "cd apps/mobile && flutter test",
    "analyze:mobile": "cd apps/mobile && flutter analyze",
    "lint": "npm --prefix apps/api run lint",
    "test:all": "npm run test:api && npm run test:mobile"
  }
}
